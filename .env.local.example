# Configuration Supabase (Pilote Cantine Pro)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique
# Clé serveur uniquement : toutes les requêtes passent par Next.js (RLS sans politique)
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-privee

# Configuration App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session RH (cookie signé) — générer avec : openssl rand -hex 32
RH_SESSION_SECRET=

# Console SuperAdmin /admin (12 caractères minimum) — générer avec : openssl rand -hex 16
SUPERADMIN_CODE=

# Numéro Wave affiché aux RH pour régler l'abonnement (optionnel)
WAVE_NUMERO_PAIEMENT=

# Cron 11h05 (Vercel envoie automatiquement Authorization: Bearer CRON_SECRET)
CRON_SECRET=

# Envoi WhatsApp au traiteur (optionnel — sinon bouton WhatsApp manuel dans le cockpit)
# Option 1 : WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Template approuvé, 3 paramètres : {{1}} entreprise, {{2}} détail (ex: "18 Yassa, 12 Thiéb"), {{3}} lien de confirmation
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr
# Option 2 : webhook générique (Make, Zapier, n8n...) — reçoit { to, message, company, date, recap, lien }
WHATSAPP_WEBHOOK_URL=
