{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/cloture",
      "schedule": "5 11 * * 1-5"
    }
  ],
  "headers": [
    {
      "source": "/icon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
